[Unit]
Description=PieJam audio mixer
Documentation=https://github.com/vilpter/piejam_pi
# Deliberately no dependency on the network (ADR 0005) or on the audio
# interface: the UI comes up first and PieJam picks up the Scarlett later.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# PieJam signals readiness with sd_notify(READY=1) once its first frame is on
# screen, so the unit becomes active exactly at "UI visible". The notifying
# process is PieJam, which piejam-launch runs as a child (not MainPID), so
# readiness must be accepted from any process in the unit (NotifyAccess=all).
Type=notify
NotifyAccess=all
# Fail and restart rather than hang if the first frame never comes.
TimeoutStartSec=30
User=piejam
Group=piejam
SupplementaryGroups=audio video render input
WorkingDirectory=~

RuntimeDirectory=piejam
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/piejam

# Render straight to DRM/KMS (ADR 0002). piejam-launch writes the KMS config.
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_HIDECURSOR=1
# Logs scene-graph setup (renderer, GL version) to the app log. Kept for
# diagnostics; "UI visible" timing now comes from sd_notify, not this.
Environment=QSG_INFO=1

ExecStart=/usr/local/lib/piejam/piejam-launch

# Quitting from the UI powers off (handled in piejam-launch). A crash restarts
# the app; after repeated failures it stays down so you can log in over SSH.
Restart=on-failure
RestartSec=2
# 143 = stopped by SIGTERM, i.e. "systemctl stop piejam". Not a failure.
SuccessExitStatus=143

# Real-time audio threads. PieJam picks its own SCHED_FIFO priorities (96 for
# audio, 80 for MIDI) and aborts if it can't get them, so allow the full range
# rather than tracking the app's numbers here.
LimitRTPRIO=99
# Memory locking must stay limited. PieJam calls mlockall(MCL_CURRENT |
# MCL_FUTURE) at startup; if that succeeds, Debian's Qt 5 crashes building
# the QML engine (it madvise()s new heap reservations, which the kernel
# refuses on locked memory). With a finite limit the call fails cleanly and
# PieJam logs "could not lock memory" and runs unlocked. 8M is systemd's
# default, set here so a changed default can't bring the crash back.
LimitMEMLOCK=8M

[Install]
WantedBy=multi-user.target
